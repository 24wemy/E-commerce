# =====================================================================
#  Fresh Minut — salin file ini menjadi .env lalu isi nilainya.
#  JANGAN commit file .env ke git.
# =====================================================================

# ---------- Database: Supabase (PostgreSQL) ----------
# Supabase Dashboard > Project > tombol "Connect" > tab "ORMs" / "Connection string"
# DATABASE_URL  = Transaction pooler (port 6543)  -> dipakai aplikasi saat berjalan
# DIRECT_URL    = Session pooler / direct (port 5432) -> dipakai untuk migrasi & seed
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# ---------- Auth (NextAuth v5) ----------
# Buat secret: npx auth secret   atau   openssl rand -base64 32
AUTH_SECRET="ganti_dengan_string_acak_32_karakter"
# URL publik aplikasi (lokal: http://localhost:3000, produksi: https://domainanda.com)
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Wajib "true" bila aplikasi berada di belakang proxy (Nginx / Cloudflare / Vercel)
AUTH_TRUST_HOST="true"
# Isi "true" HANYA bila domain sudah di-proxy Cloudflare (awan oranye) → IP pengunjung dibaca dari cf-connecting-ip
TRUST_CLOUDFLARE="false"

# ---------- Midtrans (SANDBOX) ----------
# dashboard.midtrans.com > pilih environment "Sandbox" > Settings > Access Keys
MIDTRANS_IS_PRODUCTION="false"
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxx"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxx"

# ---------- Peta & alamat (gratis, OpenStreetMap / Nominatim) ----------
# Identitas aplikasi untuk Nominatim (wajib menurut kebijakan OSM). Boleh dibiarkan default.
NOMINATIM_USER_AGENT="FreshMinut/1.0 (proyek e-commerce kampus)"

# ---------- AI (opsional, Google Gemini — Free tier) ----------
# Buat API key gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Model free tier (lihat https://ai.google.dev/gemini-api/docs/pricing). Boleh dibiarkan default.
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_FALLBACK_MODEL="gemini-3.5-flash-lite"

# ---------- Email SMTP (opsional) ----------
# Jika kosong, email tidak dikirim tetapi kampanye/pengingat tetap tercatat (status LOGGED).
# Gmail: aktifkan 2FA lalu buat "App Password" 16 karakter.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Fresh Minut <email_anda@gmail.com>"

# Tampilkan tombol akun demo di halaman login (hanya untuk presentasi, matikan setelahnya)
NEXT_PUBLIC_SHOW_DEMO_LOGIN="false"
